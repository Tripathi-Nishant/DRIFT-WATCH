# Required for Docker Compose
POSTGRES_PASSWORD=change-this-to-a-long-random-password
DRIFTWATCH_SECRET_KEY=change-this-to-a-long-random-secret

# Optional production settings
DRIFTWATCH_ALLOWED_ORIGINS=http://localhost:8765
DRIFTWATCH_MAX_BODY_BYTES=5242880
# DRIFTWATCH_WEBHOOK_URL=https://example.com/driftwatch/webhook

# Optional low-volume Gemini judge. Leave unset to use deterministic metrics.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Optional embeddings and email alerts
# DRIFTWATCH_EMBEDDING_MODEL=all-MiniLM-L6-v2
# DRIFTWATCH_IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
# DRIFTWATCH_ALERT_EMAIL=you@example.com
# DRIFTWATCH_SMTP_HOST=smtp.example.com
# DRIFTWATCH_SMTP_PORT=587
# DRIFTWATCH_SMTP_FROM=driftwatch@example.com
# DRIFTWATCH_SMTP_USER=
# DRIFTWATCH_SMTP_PASSWORD=
# DRIFTWATCH_SMTP_TLS=true
