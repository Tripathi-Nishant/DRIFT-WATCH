# Required for Docker Compose
POSTGRES_PASSWORD=change-this-to-a-long-random-password
DRIFTWATCH_SECRET_KEY=change-this-to-a-long-random-secret
DRIFTWATCH_ENV=production

# Optional production settings
DRIFTWATCH_ALLOWED_ORIGINS=https://monitor.example.com
DRIFTWATCH_MAX_BODY_BYTES=5242880
DRIFTWATCH_ACCESS_REQUEST_RATE=0.01
DRIFTWATCH_ACCESS_REQUEST_BURST=3
DRIFTWATCH_PLAN=beta
DRIFTWATCH_QUOTA_RUNS=10000
DRIFTWATCH_QUOTA_PREDICTIONS=100000
DRIFTWATCH_QUOTA_MODELS=100
DRIFTWATCH_QUOTA_API_KEYS=10
# Optional Stripe billing
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# Optional Sentry
# DRIFTWATCH_SENTRY_DSN=https://...
# DRIFTWATCH_SENTRY_TRACES=0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example/v1/traces
# DRIFTWATCH_WEBHOOK_URL=https://example.com/driftwatch/webhook
# DRIFTWATCH_WEBHOOK_SECRET=use-a-dedicated-signing-secret

# Optional low-volume Gemini judge. Leave unset to use deterministic metrics.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Optional embeddings and email alerts
# DRIFTWATCH_EMBEDDING_MODEL=all-MiniLM-L6-v2
# DRIFTWATCH_IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
# DRIFTWATCH_ALERT_EMAIL=you@example.com
# DRIFTWATCH_SMTP_HOST=smtp.example.com
# DRIFTWATCH_SMTP_PORT=587
# DRIFTWATCH_SMTP_FROM=driftwatch@example.com
# DRIFTWATCH_SMTP_USER=
# DRIFTWATCH_SMTP_PASSWORD=
# DRIFTWATCH_SMTP_TLS=true
# DRIFTWATCH_APP_URL=https://monitor.example.com
