# Copy to Caddyfile and replace the hostname after purchasing a domain.
# For temporary testing, use the AWS public IP and HTTP only.

monitor.example.com {
    reverse_proxy driftwatch:8765
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
