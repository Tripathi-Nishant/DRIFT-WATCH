FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY web ./web
# Provider image is intentionally separate: sentence-transformers brings a
# heavyweight PyTorch runtime and should not be forced on API-only deployments.
RUN pip install --no-cache-dir ".[production]"
ENV DRIFTWATCH_ENV=production
EXPOSE 8765
CMD ["driftwatch", "serve", "--host", "0.0.0.0", "--port", "8765"]
